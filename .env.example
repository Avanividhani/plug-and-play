# Google AI Studio key for Gemini / Veo video (must start with AIza)
# https://aistudio.google.com/apikey
# Optional for Motion — tried first when set. Paste in the Content UI (Save) or set here.
# Never commit .env.
GEMINI_API_KEY=

# Optional alias for Gemini
# GOOGLE_API_KEY=

# Optional: force a Veo model id
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# GEMINI_VIDEO_DURATION=6
# GEMINI_VIDEO_ASPECT_RATIO=16:9

# Pollinations key for Motion video (fallback) + still / living images.
# Prefer sk_… from https://enter.pollinations.ai/keys (needs Pollen balance for video).
# Legacy AQ.… keys work on image.pollinations.ai but gen.pollinations.ai video may reject them.
POLLINATIONS_API_KEY=
